# ---------------------------------------------------------------- Database
# Railway provides this automatically when you add the PostgreSQL plugin.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ------------------------------------------------------------------- Auth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The full public URL of the deployment, no trailing slash
NEXTAUTH_URL="https://your-app.up.railway.app"

# Used in canonical URLs, DOIs, sitemap, OAI-PMH records and emails.
# Getting this wrong breaks indexing — set it to the real public URL.
NEXT_PUBLIC_SITE_URL="https://your-app.up.railway.app"

# --------------------------------------------------------- Object storage
# REQUIRED IN PRODUCTION. Railway's filesystem is wiped on every deploy, so
# without these, uploaded PDFs and manuscripts are lost. Cloudflare R2 is the
# cheapest option that works here.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET="journal-files"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# The public read URL for the bucket, e.g. an R2 public bucket or custom domain
S3_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# ------------------------------------------------------------------ Email
# Without a key, email is logged to the server console instead of being sent.
# Submissions still work — the author just does not get a confirmation.
RESEND_API_KEY=""
EMAIL_FROM="Meridian Academic Press <noreply@yourdomain.com>"
EDITOR_NOTIFICATION_EMAIL="editor@yourdomain.com"
